<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by mtf.rc.
     activeCodePage UTF-8 (Windows 10 1903 and later): the narrow file functions (fopen, CreateFileA, GetModuleFileNameA)
     and getenv carry UTF-8, the encoding platform/win32.c and fs_host.c convert with, so an install folder or user
     profile with a non-ASCII name works.
     dpiAwareness PerMonitorV2: window, monitor and cursor sizes are physical pixels and the swapchain matches the
     screen (gfx_window_win.c relies on it). A DPI-unaware process gets them divided by the display scale and its image
     stretched back up by Windows: blurred, and a window sized for the screen opens larger than it. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
